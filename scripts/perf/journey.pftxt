# Perfetto config for a scripted journey (scripts/perf/record.sh fills in @PACKAGE@).
# Scheduling, frame timelines, the framework's and the app's atrace sections, and logcat marks.
# Streams to a file every 2.5 s, so a several-minute journey isn't limited by the ring buffer;
# expect ~2-4 MB a second on an emulator.
buffers { size_kb: 262144 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
duration_ms: 300000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 10000
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "power/cpu_frequency"
      # A process started after the trace began is otherwise left named after zygote64.
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "input"
      atrace_categories: "dalvik"
      atrace_categories: "binder_driver"
      atrace_categories: "res"
      atrace_categories: "bionic"
      atrace_apps: "@PACKAGE@"
      buffer_size_kb: 16384
      drain_period_ms: 250
    }
  }
}
# Per-frame expected vs actual timelines: frame durations without guessing from slices.
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 0 } }
# The journey's step marks (`adb shell log -t HomeSafeJourney name:start|end`).
data_sources { config { name: "android.log" target_buffer: 1 android_log_config { log_ids: LID_DEFAULT filter_tags: "HomeSafeJourney" filter_tags: "ActivityTaskManager" } } }
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
  }
}
