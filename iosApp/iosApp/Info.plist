<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>HomeSafe uses Face ID to securely sign you in without retyping your password.</string>
	<!--
	  Frigate's go2rtc live-stream endpoint (port 1984) is plain HTTP by design — it relies
	  on the network boundary (Tailscale, or the home LAN when connected over the server's
	  private address) for trust rather than TLS. The authenticated Frigate API itself
	  (port 8971) is HTTPS and unaffected by this. Mirrors the Android
	  network_security_config.xml cleartext allowance for the same reason.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>