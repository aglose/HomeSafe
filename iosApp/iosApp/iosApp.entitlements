<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications: the relay pushes straight to the app through APNs (docs/notifications.md, "iPhone").
	     "development" while Xcode signs for a phone; an App Store, TestFlight or ad hoc export swaps in "production". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
