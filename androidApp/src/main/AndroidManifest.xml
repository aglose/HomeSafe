<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app notice Wi-Fi ↔ cellular changes and re-pick the server's local vs Tailscale address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 keeps an app that targets it off the Wi-Fi's own addresses until the user grants
         this; without it the server's LAN address times out and everything goes over Tailscale.
         Asked at sign-in (LocalNetworkAccess.android.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Detection alerts are posted as local notifications (see AlertNotifier.android.kt); Android 13+ asks the user first. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeSafe">
        <!-- Lets Macrobenchmark (the :baselineprofile module) profile release builds from the shell. -->
        <profileable android:shell="true" />
        <!-- singleTask: a notification tap (or any relaunch) resumes the running instance instead of
             stacking a second MainActivity — and a second app graph, poller, and sign-in screen — on top. -->
        <!-- configChanges: the UI is all Compose, which re-lays itself out when the window changes,
             so a rotation (or a fold, a split-screen resize, a keyboard docking, the system
             theme flipping at sunset) must not recreate the Activity. A recreation builds a new
             app graph: back to the sign-in screen, the navigation stack gone and every live
             stream reconnecting. Rotating to watch a camera full screen is the case that matters
             most (see CameraDetailScreen). -->
        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- homesafe://moment?camera=…&start_time=…: one detection, full screen (MomentDeepLink.kt).
                 The app's own notifications name this Activity explicitly; the filter is what lets
                 the same link open from anywhere else (adb, a browser, another app). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="moment" />
            </intent-filter>
            <!-- homesafe://weather: the weather app, which is where a weather notification's tap
                 lands (WeatherDeepLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="weather" />
            </intent-filter>
        </activity>

        <!-- Receives pushes from the HomeSafe relay (see androidApp/.../push/) and fresh FCM tokens. -->
        <service
            android:name=".push.HomeSafeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>