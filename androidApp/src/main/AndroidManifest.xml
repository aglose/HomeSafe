<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the app notice Wi-Fi ↔ cellular changes and re-pick the server's local vs Tailscale address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 keeps an app that targets it off the Wi-Fi's own addresses until the user grants
         this; without it the server's LAN address times out and everything goes over Tailscale.
         Asked at sign-in (LocalNetworkAccess.android.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Detection alerts are posted as local notifications (see AlertNotifier.android.kt); Android 13+ asks the user first. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- enableOnBackInvokedCallback: predictive back on Android 13-15 too (16 on has it by default),
         both the system's back-to-home preview and the in-app ones Navigation 3 and
         PredictiveBack.kt draw as the finger moves. Without it those versions get a plain Back
         press at the end of the swipe and nothing to see during it. -->
    <application
        android:name=".HomeSafeApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeSafe">
        <!-- Lets Macrobenchmark (the :baselineprofile module) profile release builds from the shell. -->
        <profileable android:shell="true" />
        <!-- singleTask: a notification tap (or any relaunch) resumes the running instance instead of
             stacking a second MainActivity — and a second app graph, poller, and sign-in screen — on top. -->
        <!-- configChanges: the UI is all Compose, which re-lays itself out when the window changes,
             so a rotation (or a fold, a split-screen resize, a keyboard docking, the system
             theme flipping at sunset) must not recreate the Activity. A recreation builds a new
             app graph: back to the sign-in screen, the navigation stack gone and every live
             stream reconnecting. Rotating to watch a camera full screen is the case that matters
             most (see CameraDetailScreen). -->
        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <!-- No LAUNCHER filter here: the home-screen entry is one of the AppIcon aliases below. -->
            <!-- homesafe://moment?camera=…&start_time=…: one detection, full screen (MomentDeepLink.kt).
                 The app's own notifications name this Activity explicitly; the filter is what lets
                 the same link open from anywhere else (adb, a browser, another app). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="moment" />
            </intent-filter>
            <!-- homesafe://finance?tab=budget: the finance app, on one of its tabs (FinanceDeepLink.kt).
                 Where a budget notification's tap lands. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="finance" />
            </intent-filter>
            <!-- homesafe://doors?door=…: the Doors page on Home, where a door notification's tap
                 lands (DoorDeepLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="doors" />
            </intent-filter>
            <!-- homesafe://weather: the weather app, which is where a weather notification's tap
                 lands (WeatherDeepLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="weather" />
            </intent-filter>
            <!-- homesafe://packages?package=…: the packages app, on the parcel a notification was about (PackageDeepLink.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="homesafe" android:host="packages" />
            </intent-filter>
            <!-- Plain text shared from another app (a note, from a notes app's Share menu): workout
                 notes, which open on the fitness app's import page to be looked over before
                 anything is saved (FitnessShare.kt). The label is what the share sheet shows. -->
            <intent-filter android:label="@string/share_workout_notes">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The launcher entry, one alias per app icon the Settings page offers (AppIcon in :shared;
             the artwork comes from tools/app-icons). Exactly one is enabled: the first by default,
             afterwards whichever AppIconSwitcher.android.kt enabled. Notifications name
             MainActivity itself (appLaunchIntent), so switching icons can't strand one. -->
        <activity-alias
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:name=".AppIconClassic"
