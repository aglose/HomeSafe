    <!-- The history at the bottom of the page. -->
    <string name="doors_history_title">Last 7 days</string>
    <string name="doors_history_empty">No door has opened in the last week.</string>
    <string name="doors_history_opened">%1$s opened</string>
    <string name="doors_history_closed">%1$s closed</string>
    <string name="doors_history_notified">Notified</string>
