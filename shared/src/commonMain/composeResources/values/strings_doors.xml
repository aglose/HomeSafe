    <plurals name="doors_day_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>

    <!-- When there is nothing to show. -->
    <string name="doors_none_title">No door sensors yet</string>
    <string name="doors_none_body">Pair a sensor on the server's Zigbee2MQTT page and name it there. It shows up here within a few seconds.</string>
