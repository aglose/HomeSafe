    <string name="doors_rename_action">Rename %1$s</string>
    <string name="doors_rename_title">Name this door</string>
    <string name="doors_rename_label">Name</string>
    <string name="doors_rename_placeholder">Front door</string>
    <string name="doors_rename_invalid">A name can't be blank, be over 64 characters, or use / + or #</string>
    <string name="doors_rename_failed">Couldn't rename that door: %1$s</string>
