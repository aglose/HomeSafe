<!--
  The door sensors: the Doors strip on Home, the Doors page it opens (also from Settings), and each
  door's alert setting. Keys: doors_*. See AGENTS.md, "Strings and localization".
-->
<resources>
    <string name="doors_title">Doors</string>
    <string name="doors_subtitle">Door sensors and their alerts</string>
    <!-- The row on the Settings page that opens the Doors page. -->
