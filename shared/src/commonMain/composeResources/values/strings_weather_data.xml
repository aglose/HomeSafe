<?xml version="1.0" encoding="utf-8"?>
<!--
  The weather app's words that are made outside its screens: the sky's names, units, the clock
  and calendar, the forecast told as sentences (WeatherStory) and its notifications
  (WeatherNoticePlanner). The screens' own labels are in strings_weather.xml.
  See AGENTS.md, "Strings and localization".
-->
