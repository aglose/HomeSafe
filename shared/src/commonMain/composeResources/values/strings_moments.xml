    <!-- A card's title. %1$s is what was seen ("Person", "Sarah's Tesla"); %2$s is a zone's name in lower case ("front lawn"). -->
    <string name="moments_title_detected">%1$s detected</string>
    <!-- For enclosed places: the driveway, the garage, the porch. -->
    <string name="moments_title_in_zone">%1$s in the %2$s</string>
    <!-- For surfaces: the front lawn, the sidewalk, the street. -->
    <string name="moments_title_on_zone">%1$s on the %2$s</string>
    <!-- A household car's comings and goings folded into one row. %1$s is the car's name, %2$d how many times. -->
    <plurals name="moments_title_came_and_went">
        <item quantity="one">%1$s came and went once</item>
        <item quantity="other">%1$s came and went %2$d×</item>
    </plurals>

    <!-- A visit still going on. %1$s is a clock time ("6:55 PM"). -->
    <string name="moments_since">Since %1$s</string>
    <!-- A parked vehicle seen again and again. %1$d is how many sightings, %2$s a clock time. -->
    <plurals name="moments_seen_still_there">
        <item quantity="one">Seen once · still there</item>
        <item quantity="other">Seen %1$d times · still there</item>
    </plurals>
    <plurals name="moments_seen_last_seen">
        <item quantity="one">Seen once · last seen %2$s</item>
        <item quantity="other">Seen %1$d times · last seen %2$s</item>
    </plurals>
    <!-- On a card that folds several clips together; tapping it lists them. -->
    <plurals name="moments_clip_count">
        <item quantity="one">%1$d clip</item>
        <item quantity="other">%1$d clips</item>
    </plurals>
    <plurals name="moments_sighting_count">
        <item quantity="one">%1$d sighting</item>
        <item quantity="other">%1$d sightings</item>
    </plurals>

