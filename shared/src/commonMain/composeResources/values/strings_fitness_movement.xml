<!--
  The figure that performs each exercise in the fitness app: the three ways it can be drawn
  (FigureStyle.kt), as the Settings row (FigureStyleOptions.kt) and the chips on an exercise's
  page show them, and the names of the muscle heads it calls out (HeadLabels.kt).
  See AGENTS.md, "Strings and localization".
-->
<resources>
    <!-- The three figures -->
    <string name="fitness_figure_true_3d_label">True 3D</string>
    <string name="fitness_figure_true_3d_blurb">A modelled lifter, rendered ahead of time and played back, the working muscles glowing through the skin.</string>
    <string name="fitness_figure_stone_label">Stone</string>
    <string name="fitness_figure_stone_blurb">A figure of pale stone, drawn as you watch, the working muscles lit from inside.</string>
    <string name="fitness_figure_forged_label">Forged study</string>
    <string name="fitness_figure_forged_blurb">An anatomy study in dark iron, drawn as you watch, with every working muscle traced and gauged.</string>

    <!-- What a screen reader says of the large figure, whose labels are painted and not text: the names of the muscles it calls out, head to toe, with commas between -->
    <string name="fitness_figure_working_muscles">Working muscles: %1$s</string>

    <!--
      Under a figure that may not be doing this exercise: its name wasn't one the app knows a movement for, so the
      figure is the likeliest for its shelf. %1$s is that movement's name, from the list below.
    -->
    <string name="fitness_figure_nearest">Nearest figure: %1$s</string>

