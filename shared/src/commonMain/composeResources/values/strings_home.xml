<?xml version="1.0" encoding="utf-8"?>
<!--
  The home page, a camera's own screen, the app shell (top bar, bottom bar, drawer) and the
  shared live-video components. Keys are prefixed home_, camera_, shell_ and player_.
  See AGENTS.md, "Strings and localization".
-->
<resources>
    <!-- The rows of pills at the top of Home: the doors, and the household's Teslas. -->
    <string name="home_glance_all_doors_closed">All doors closed</string>
    <plurals name="home_glance_doors_closed">
        <item quantity="one">%1$d door closed</item>
        <item quantity="other">%1$d doors closed</item>
    </plurals>

    <string name="home_no_cameras">No cameras found on this server.</string>
    <!-- Home with every camera in the list hidden in Arrange mode. "Arrange cameras" is the menu item (home_arrange_menu). -->
    <string name="home_all_cameras_hidden">Every camera here is hidden. Choose Arrange cameras in the menu to bring one back.</string>
    <!-- The Home page's switch between the Frigate cameras outside and the Nest cameras inside. -->
    <string name="home_placement_outdoor">Outdoor</string>
    <string name="home_placement_indoor">Indoor</string>
    <!-- Arrange mode: the cameras dragged into order, turned the right way up, and hidden from Home or brought back. -->
    <string name="home_arrange_menu">Arrange cameras</string>
    <string name="home_arrange_menu_done">Done arranging</string>
    <string name="home_arrange_done">Done</string>
    <string name="home_arrange_hint">Hold a camera to drag it. Tap it to straighten, zoom or crop its picture. Hidden cameras show only here.</string>
    <string name="camera_move_earlier">Move earlier</string>
    <string name="camera_move_later">Move later</string>
    <string name="camera_turn_left">Turn left</string>
    <string name="camera_turn_right">Turn right</string>
    <!-- On a camera card in Arrange mode: leaves the camera off the Home page, or puts a hidden one back. -->
    <string name="camera_hide">Hide from Home</string>
    <string name="camera_show">Show on Home</string>
    <!-- Over a hidden camera's card in Arrange mode. -->
    <string name="camera_hidden_badge">Hidden</string>
    <!-- On a camera card in Arrange mode: opens the framing editor. Short: it sits between the two turn buttons. -->
    <string name="camera_frame_button">Frame</string>
    <!-- Accessibility label for tapping a camera card in Arrange mode, which opens the framing editor. -->
    <string name="camera_frame_click_label">Frame the picture</string>
    <!-- The framing editor: a camera's picture straightened, zoomed and cropped. %1$s is the camera's name, e.g. "Frame Living Room". -->
    <string name="camera_frame_title">Frame %1$s</string>
    <string name="camera_frame_done">Done</string>
    <string name="camera_frame_hint">Drag to move the picture, pinch to zoom, twist to straighten. Only what's inside the frame shows.</string>
    <!-- The fine rotation of the picture, as in a photo editor. -->
    <string name="camera_frame_straighten">Straighten</string>
    <!-- The straightening angle; %1$s is the signed number with one decimal place, e.g. "+2.4" or "-0.5". -->
    <string name="camera_frame_straighten_value">%1$s°</string>
    <!-- Accessibility label for tapping the angle, which sets it back to level. -->
    <string name="camera_frame_level">Level</string>
    <!-- The arrows either side of the straighten ruler: a tenth of a degree each tap. -->
    <string name="camera_frame_nudge_left">Straighten a tenth of a degree left</string>
    <string name="camera_frame_nudge_right">Straighten a tenth of a degree right</string>
    <string name="camera_frame_zoom">Zoom</string>
    <!-- The magnification; %1$s is the number with one decimal place, e.g. "1.8". -->
    <string name="camera_frame_zoom_value">%1$s×</string>
    <!-- Back to the whole picture, upright. -->
    <string name="camera_frame_reset">Reset</string>
    <string name="home_away_banner">Away mode · nobody home · alerts escalated</string>
    <string name="home_away_back">I'm back</string>
    <!-- The notice at the top of Home while the app is signed in but can't reach the server. -->
    <string name="home_connection_tailscale_off_title">Tailscale isn't connected on this device</string>
    <string name="home_connection_tailscale_off_body">This device has no route to the server without it. Open the Tailscale app and connect. Until then you're seeing what this device kept.</string>
    <string name="home_connection_unreachable_title">Can't reach the server</string>
    <string name="home_connection_unreachable_body">It isn't answering on your home network or over Tailscale. You're seeing what this device kept.</string>
    <string name="home_connection_open_tailscale">Open Tailscale</string>
    <string name="home_connection_retry">Try again</string>
    <string name="home_connection_retrying">Trying…</string>

    <!-- The pill in the corner of a camera card. -->
    <string name="home_badge_disabled">Disabled</string>
    <string name="home_badge_connecting">Connecting</string>
    <string name="home_badge_live">Live</string>

    <!-- A camera's own screen: the bar under the player (quality, sound, clip). -->
    <!-- Short names for the stream qualities, as a video player's menu would show them. -->
    <string name="camera_quality_auto">Auto</string>
    <string name="camera_quality_high">HD</string>
    <string name="camera_quality_low">SD</string>
    <string name="camera_quality_auto_description">Quick to start, then sharpens</string>
    <string name="camera_quality_high_description">Full resolution, with the camera's sound</string>
    <string name="camera_quality_low_description">Lighter on data, no sound</string>
    <string name="camera_quality_menu_title">Video quality</string>
    <!-- Accessibility description of the quality button; %1$s is the current quality, e.g. "HD". -->
    <string name="camera_quality_button_description">Video quality: %1$s</string>
    <!-- Accessibility description of the tick beside the quality in force. -->
    <string name="camera_quality_selected">Selected</string>
    <!-- Accessibility descriptions of the speaker button. -->
    <string name="camera_sound_turn_on">Turn sound on</string>
    <string name="camera_sound_turn_off">Turn sound off</string>
    <!-- Under a Google Nest camera's video: why its page has no timeline or recent activity. -->
    <string name="camera_nest_live_only">Live only. Nest cameras stream from Google while you watch, and HomeSafe doesn't record them.</string>
    <!-- The Nest camera page's button between showing the whole picture and filling the frame; it names what a tap does. -->
    <string name="camera_nest_fit_fill">Fill the frame</string>
    <string name="camera_nest_fit_whole">Show the whole picture</string>
    <!-- The Nest camera page's button for talking through the camera's speaker. Google only lets its own app do that, so the button opens Google Home; the label says so because the tap leaves HomeSafe. -->
    <string name="camera_nest_talk">Talk in Google Home</string>
    <!-- Accessibility description of the scissors button, which cuts a clip of the video; %1$s is the camera's name. -->
    <string name="camera_action_clip_description">Clip a video from %1$s</string>
    <!-- One-line feedback under the player's bar after a tap. -->
    <string name="camera_hint_single_quality">This camera has a single stream quality</string>
    <string name="camera_hint_sound_on_no_audio">Sound on, but this stream has no audio</string>
    <string name="camera_hint_sound_on">Sound on</string>
    <string name="camera_hint_sound_off">Sound off</string>

    <!-- A camera's own screen: the player and the page under it. -->
    <!-- The pill on the player at the live edge. -->
    <string name="camera_live">LIVE</string>
    <!-- The same pill while watching a recording: a button back to the live edge. -->
    <string name="camera_go_live">GO LIVE</string>
    <!-- How far behind live the recording on screen is; %1$s is a duration such as "4:05". -->
    <string name="camera_behind_live">-%1$s</string>
    <string name="camera_play">Play</string>
    <string name="camera_pause">Pause</string>
    <!-- What a tap on the full-screen video does, for a screen reader or a keyboard: its controls fade away when left alone. -->
    <string name="camera_show_controls">Show controls</string>
    <string name="camera_hide_controls">Hide controls</string>
    <!-- Over the side of the video after a double tap there: how far that stepped, in all. -->
    <plurals name="camera_skip_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <!-- The same two steps as actions for a screen reader, which has no double tap to give. -->
    <plurals name="camera_skip_back">
        <item quantity="one">Back %1$d second</item>
        <item quantity="other">Back %1$d seconds</item>
    </plurals>
    <plurals name="camera_skip_forward">
        <item quantity="one">Forward %1$d second</item>
        <item quantity="other">Forward %1$d seconds</item>
    </plurals>
    <string name="camera_timeline">Timeline</string>
    <!-- The timeline's span choices: one hour, three hours, twelve hours, a day. -->
    <string name="camera_span_1h">1h</string>
    <string name="camera_span_3h">3h</string>
    <string name="camera_span_12h">12h</string>
    <string name="camera_span_24h">24h</string>
    <!-- The buttons under the timeline that jump to the detection before or after the one playing. -->
    <string name="camera_previous_detection">Previous detection</string>
    <string name="camera_next_detection">Next detection</string>
    <string name="camera_no_recordings">No recordings in this window yet</string>
    <!-- %1$s is the reason, as the server or the platform gave it. -->
    <string name="camera_history_error">Couldn't load recordings: %1$s</string>
    <string name="camera_recent_activity">Recent Activity</string>
    <string name="camera_recent_loading">Looking for recent detections…</string>
    <string name="camera_recent_empty">No detections on this camera yet.</string>
    <!-- On a recent detection's card; %1$s is the clip's length, e.g. "0:15". -->
    <string name="camera_moment_clip_length">%1$s clip</string>
    <!-- The camera screen's overflow menu. -->
    <string name="camera_menu_detection_zones">Detection zones</string>
    <string name="camera_menu_tag_cars">Tag cars in view</string>
    <!-- The menu's switch for the panel below, named as video players name theirs. -->
    <string name="camera_menu_stats_show">Stats for nerds</string>
    <string name="camera_menu_stats_hide">Hide stats for nerds</string>

    <!-- The "stats for nerds" panel over a camera's live video: what the stream is doing, measured as it plays. -->
    <string name="camera_stats_title">Stats for nerds</string>
    <string name="camera_stats_close">Close stats for nerds</string>
    <!-- In place of the figures until the player has its first reading. -->
    <string name="camera_stats_measuring">Measuring…</string>
    <!-- In place of the figures while a recording plays: there is nothing live to measure. -->
    <string name="camera_stats_recording">Go live to see the stream's stats</string>
    <!-- The label beside how old the picture is by the time it is shown, counted from the moment the camera server had it: "Behind server  240 ms". -->
    <string name="camera_stats_delay">Behind server</string>
    <!-- In place of a delay on a device whose player can't measure one. -->
    <string name="camera_stats_delay_unknown">Not measured on this device</string>
    <!-- What the delay is made of: crossing the network, waiting in the player's buffer, being decoded. -->
    <string name="camera_stats_network">Network</string>
    <string name="camera_stats_buffer">Buffer</string>
    <string name="camera_stats_decode">Decode</string>
    <!-- A length of time in whole milliseconds. -->
    <string name="camera_stats_milliseconds">%1$d ms</string>
    <!-- A length of time in seconds to one decimal place: %1$d is the whole seconds and %2$d the tenths ("1.4 s"). The mark between them is the language's decimal separator. -->
    <string name="camera_stats_seconds">%1$d.%2$d s</string>
    <!-- How the video is reaching this device. -->
    <string name="camera_stats_connection">Connection</string>
    <string name="camera_stats_connection_webrtc">WebRTC</string>
    <string name="camera_stats_connection_hls">HLS</string>
    <string name="camera_stats_connection_fmp4">fMP4</string>
    <string name="camera_stats_video">Video</string>
    <!-- %1$d and %2$d are the picture's width and height in pixels. -->
    <string name="camera_stats_resolution">%1$d×%2$d</string>
    <!-- %1$d is frames a second. -->
    <string name="camera_stats_frame_rate">%1$d fps</string>
    <string name="camera_stats_bitrate">Bitrate</string>
    <!-- %1$d is kilobits a second. -->
    <string name="camera_stats_kbps">%1$d kbps</string>
    <!-- Megabits a second to one decimal place: %1$d is the whole megabits and %2$d the tenths ("2.1 Mbps"). The mark between them is the language's decimal separator. -->
    <string name="camera_stats_mbps">%1$d.%2$d Mbps</string>
    <!-- Beside what never made it to the screen: frames the player had to skip, then packets the network lost ("0 frames · 3 packets"). -->
    <string name="camera_stats_dropped">Dropped</string>
    <plurals name="camera_stats_dropped_frames">
        <item quantity="one">%1$d frame</item>
        <item quantity="other">%1$d frames</item>
    </plurals>
    <plurals name="camera_stats_lost_packets">
        <item quantity="one">%1$d packet</item>
        <item quantity="other">%1$d packets</item>
    </plurals>

