    <!-- The Wallet's card when the budget sheet can't be read: a title and what fixes it. -->
    <string name="fin_sheet_setup_not_shared_title">Share your budget sheet</string>
    <string name="fin_sheet_setup_not_shared_body">The server reads your sheet with its own Google account, so the sheet never has to be public. Open the sheet, tap Share, and add this address as a Viewer:</string>
    <string name="fin_sheet_setup_api_disabled_title">Turn on the Google Sheets API</string>
    <string name="fin_sheet_setup_api_disabled_body">The server's Google Cloud project needs the Sheets API switched on once. Open the link below, tap Enable, then come back and retry.</string>
    <string name="fin_sheet_setup_not_configured_title">Point the server at your sheet</string>
    <string name="fin_sheet_setup_not_configured_body">Put FINANCE_SHEET_ID=&lt;the sheet's id&gt; (the long part of its URL) in relay/finance.env on the server and restart the relay. It stays out of the public docker-compose.yml.</string>
    <string name="fin_sheet_setup_no_key_title">The server has no Google key</string>
    <string name="fin_sheet_setup_no_key_body">The relay reads the sheet with a Google service-account key. Set FINANCE_SHEET_KEY to its path (the push key works) and restart the relay.</string>
    <string name="fin_sheet_setup_relay_outdated_title">Update the server's relay</string>
    <string name="fin_sheet_setup_relay_outdated_body">The relay on your server is older than the finance app. Copy relay/ to the server and run docker compose up -d --build there.</string>
    <string name="fin_sheet_setup_not_allowed_title">Not for this account</string>
    <string name="fin_sheet_setup_not_allowed_body">The household's finances are shown to the server's admin accounts only. Sign in with one to see them here.</string>
    <string name="fin_sheet_setup_signed_out_title">Sign in to see your money</string>
    <string name="fin_sheet_setup_signed_out_body">Your budget comes through your PercySafe server, so it shows once you're connected.</string>
    <string name="fin_sheet_setup_not_found_title">Sheet not found</string>
