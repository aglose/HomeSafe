    <!-- A weight, written the way its exercise counts it. %1$s is the number, already formatted -->
    <string name="fitness_weight_pounds">%1$s lb</string>
    <!-- A pair of dumbbells: %1$s is one of them -->
    <string name="fitness_weight_per_hand">%1$s lb × 2</string>
    <!-- A machine's pin -->
    <string name="fitness_weight_level">Pin %1$s</string>
    <string name="fitness_weight_bodyweight">Bodyweight</string>
    <!-- Bodyweight with %1$s pounds hung on -->
    <string name="fitness_weight_bodyweight_plus">Bodyweight + %1$s lb</string>
    <plurals name="fitness_weight_plates">
        <item quantity="one">%1$d plate</item>
        <item quantity="other">%1$d plates</item>
    </plurals>
    <!-- %1$d plates a side and %2$s pounds more a side -->
    <plurals name="fitness_weight_plates_plus">
        <item quantity="one">%1$d plate + %2$s</item>
        <item quantity="other">%1$d plates + %2$s</item>
    </plurals>
    <!-- A set in one breath: %1$s the weight as written above, %2$d the reps -->
    <string name="fitness_set_line">%1$s × %2$d</string>

