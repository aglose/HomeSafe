    <!-- %1$s is a time of day ("7:30 AM"). -->
    <string name="atlas_insight_better_departure">Leaving for work around %1$s makes the trip about %2$d minutes shorter.</string>
    <!-- %1$s is a place, %4$s how long ago ("5 months ago"). -->
    <string name="atlas_insight_drifted">You went to %1$s %2$d times, about every %3$d days. You were last there %4$s.</string>
    <!-- %1$s is a place, %2$s a weekday, %4$s a time of day. -->
