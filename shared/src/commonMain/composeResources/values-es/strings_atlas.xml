    <string name="atlas_insight_late_weekday">Un %1$s cualquiera sales al trabajo %2$d minutos más tarde de lo habitual.</string>
    <string name="atlas_insight_better_departure">Si sales al trabajo alrededor de las %1$s, el trayecto dura unos %2$d minutos menos.</string>
