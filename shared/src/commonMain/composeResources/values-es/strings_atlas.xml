    <string name="atlas_insight_habit">%1$s es un hábito de cada %2$s: %3$d visitas en el último año, normalmente alrededor de las %4$s.</string>
    <string name="atlas_insight_new_places_more">En %2$d fuiste a %1$d lugares por primera vez, más que los %3$d del año anterior.</string>
    <string name="atlas_insight_new_places_fewer">En %2$d fuiste a %1$d lugares por primera vez, menos que los %3$d del año anterior.</string>
    <string name="atlas_insight_shape_returner">Tu vida gira en torno a dos lugares. Explican el %1$d% de lo lejos que se reparten tus visitas.</string>
    <string name="atlas_insight_shape_explorer">Te mueves mucho más allá de tus dos lugares principales. Explican solo el %1$d% de lo lejos que se reparten tus visitas.</string>
