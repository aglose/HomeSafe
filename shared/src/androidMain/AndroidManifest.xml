<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Automatic presence (docs/away-mode.md): a geofence around home flips this phone's away
         switch. Foreground location sets home and is asked first; background location is what
         lets the fence fire with the app closed and is asked second, per Android's rules. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Geofences don't survive a reboot; BootReceiver re-arms the home fence. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The fitness app's live heart rate, from a Bluetooth heart-rate sensor such as a Fitbit Air
         sharing its heart rate (HeartRateLink.android.kt). Asked for when the user taps Connect.
         neverForLocation: the scan is only ever for the Heart Rate Service and is never used to
         work out where the phone is, so no location permission is needed with it. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The app is for the cameras first: a device without Bluetooth LE still installs it. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- The fitness app's steps, sleep, readiness and runs, read from Health Connect, which is
         where the Google Health app puts what a Fitbit band records (HealthSource.android.kt).
         Read only: nothing is written there, and nothing read leaves the phone. Asked for when
         the user taps Connect on the fitness app's front page, each kind allowed or refused by
         itself. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <!-- Runs from more than thirty days before the app was first let in. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- What "Allow all routes" grants on the sheet Health Connect shows when a run's route is
         asked for; without it declared the sheet only offers the one route. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />

    <!-- Recording a run in the fitness app (RunLocation.android.kt): the GPS, about once a second,
         while a foreground service of the location type keeps the app running with the screen
         off. Only the location above is used ("while in use", asked when Start is tapped); the
         service is what lets it go on with the screen off. Nothing is kept running after the
         run is finished. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- A workout in progress outside the fitness app (LiveWorkoutSurface.android.kt): an ongoing
         notification that Android 16 promotes to a Live Update, with a chip in the status bar
         counting the rest down, kept up by a foreground service of the health type. That type
         starts only once heart rate may be read (Health Connect, asked for with the health store)
         and connectedDevice only once the heart-rate sensor may be linked, which is what keeps
         its link up with the screen off; with neither, the notification is posted without the
         service. The wake lock is held only while a rest counts down, so its end buzzes on time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The "Open Tailscale" button on the Home notice (TailscaleApp.android.kt): Android 11+
         hides other apps from this one unless they are named here. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <!-- Google Home, which the Nest camera page opens to talk through a camera
             (GoogleHomeApp.android.kt). -->
        <package android:name="com.google.android.apps.chromecast.app" />
        <!-- Health Connect, which is an app of its own on Android 13. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- What the app reads from Health Connect and why: Health Connect won't show its
             permission sheet for an app that has no such page, and links to it from its own
             settings. On Android 13 it asks for it by the androidx action; from 14 it is part of
             the system and asks through the alias below. -->
        <activity
            android:name="com.meticulouscreations.homesafe.fitness.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.meticulouscreations.homesafe.fitness.ViewHealthPermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="com.meticulouscreations.homesafe.fitness.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.meticulouscreations.homesafe.fitness.data.RunRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name="com.meticulouscreations.homesafe.fitness.live.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="health|connectedDevice" />

        <!-- The workout notification's rest buttons: skip, fifteen seconds less, fifteen more. -->
        <receiver
            android:name="com.meticulouscreations.homesafe.fitness.live.WorkoutActionReceiver"
            android:exported="false" />

        <receiver
            android:name="com.meticulouscreations.homesafe.data.GeofenceBroadcastReceiver"
            android:exported="false" />

        <receiver
            android:name="com.meticulouscreations.homesafe.data.NotAPersonReceiver"
            android:exported="false" />

        <receiver
            android:name="com.meticulouscreations.homesafe.data.NotificationGroupReceiver"
            android:exported="false" />

        <!-- The Doors tile in Quick Settings: whether a door is open, read from the relay as this
             install when the shade comes down; a tap opens the Doors page. -->
        <service
            android:name="com.meticulouscreations.homesafe.tile.DoorsTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_door"
            android:label="@string/tile_doors_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.meticulouscreations.homesafe.data.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
